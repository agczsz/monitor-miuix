{
  "name": "极简探针",
  "short": "miuix",
  "description": "极简清晰的服务器节点状态面板，采用轻盈的 Miuix 设计风格。",
  "version": "0.1.2",
  "author": "agczsz",
  "url": "https://github.com/agczsz/monitor-miuix",
  "config": [
    {
      "type": "title",
      "label": "首页"
    },
    {
      "type": "title",
      "label": "节点卡片"
    },
    {
      "key": "node_card_accent",
      "type": "select",
      "label": "卡片左侧强调色",
      "default": "blue",
      "help": "统一设置所有节点卡片左侧的强调色，不影响主界面配色。",
      "options": [
        { "value": "blue", "label": "澎湃蓝" },
        { "value": "cyan", "label": "碧海青" },
        { "value": "green", "label": "翡翠绿" },
        { "value": "orange", "label": "科技橙" },
        { "value": "purple", "label": "星云紫" }
      ]
    },
    {
      "key": "show_summary",
      "type": "boolean",
      "label": "显示运行总览",
      "default": true,
      "help": "显示在线节点、平均负载、流量与区域统计。"
    },
    {
      "key": "notice",
      "type": "text",
      "label": "公告",
      "default": "",
      "help": "显示在节点列表之前，留空则不显示。"
    }
  ]
}
